# ── 배포 시 설정 권장 ─────────────────────────────────────────────
# 세션 쿠키 서명 키. 설정하지 않으면 공개된 기본값을 쓰므로 반드시 지정하세요.
# 생성 예: python3 -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=

# ── 답변 생성 백엔드: extractive(기본) | llm ──────────────────────
ANSWER_BACKEND=extractive
# LLM 모드에서만 사용. 값은 서버 환경변수에만 두고 저장소에 커밋하지 않습니다.
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen3:8b
# LLM_API_KEY=

# ── 임베딩 백엔드: tfidf_heading(기본) | e5 | none ────────────────
EMBEDDING_BACKEND=tfidf_heading
# EMBEDDING_MODEL=intfloat/multilingual-e5-small

# ── 검색·게이트 파라미터 (골든셋 실측값) ──────────────────────────
# tools/tune_thresholds.py 로 재산출할 수 있습니다.
HYBRID_ALPHA=0.4
GATE_COS_TOP1=0.274
GATE_HYBRID_TOP1=0.564
HEADING_REPEAT=3

# ── 저장소 ────────────────────────────────────────────────────────
# 비워두면 data/storage 를 쓰고, 쓰기 불가 환경에서는 /tmp 로 자동 전환합니다.
# STORAGE_DIR=
